# Configuration du V9 TOOL AI COMMENT BOT
# Copier ce fichier en .env et remplir vos valeurs

# Token Discord du bot
# Obtenir le token: https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_token_here

# Mode débogage
DEBUG=False

# Niveau de logging (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Chemin de la base de données SQLite
DATABASE_PATH=data/bot.db

# Chemin du fichier logs JSON
LOGS_PATH=data/logs.json